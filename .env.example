# C-SEC Mobile Client Environment Template
# Copy this file to .env for local configuration

# URL to the Python Flask backend (e.g. Render production URL or local development tunnel)
EXPO_PUBLIC_API_URL=https://csec-sentinel-api.onrender.com

# Optional Cloudinary fallback (Leave empty to use Firebase Storage default)
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# NOTE: Do NOT place GEMINI_API_KEY here.
# Sensitive provider keys belong exclusively in the backend server environment.
