{
  "expo": {
    "name": "CSEC",
    "slug": "C-SEC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/CSECLOGOV2.png",
    "scheme": "csec",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.csec.app"
    },
    "android": {
      "package": "com.sad.csec",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https"
            },
            {
              "scheme": "http"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/CSECLOGOV2.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F9F7E8",
          "dark": {
            "backgroundColor": "#F9F7E8"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CsecWidget",
              "label": "C-SEC History",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "description": "View recent scanned URLs"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b80ccea-855a-42c7-9505-f07e83d788c8"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/7b80ccea-855a-42c7-9505-f07e83d788c8"
    }
  }
}
