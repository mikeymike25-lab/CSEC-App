# C-SEC Sentinel Flask Backend Environment Variables
# Copy to backend/.env for local development

# Google Gemini API Key (Required for AI URL explanations & Sentinel chat)
# For production, configure this directly in Render Dashboard -> Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=false

# Firebase Admin Authentication
# Option A: Path to serviceAccountKey.json on disk (local development)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# Option B: Raw JSON string of service account (ideal for cloud dashboards like Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Security Configuration
REQUIRE_AUTH=true
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://csec-sentinel.web.app
