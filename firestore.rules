rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify if caller holds cryptographically signed Custom Claim 'admin == true'
    // OR has role == 'admin' in their users document (for seamless backwards compatibility)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // System configuration and statistics: Accessible for read by authenticated agents, writable ONLY by admins
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User profile documents:
    // - Authenticated users can read directory data
    // - Creation is restricted to own UID, and cannot self-assign role = 'admin'
    // - Updates by regular users cannot alter sensitive fields ('role', 'accountStatus')
    // - Full update/delete allowed for verified admins
    match /users/{userId} {
      allow read: if request.auth != null;
      
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && (!('role' in request.resource.data) || request.resource.data.role != 'admin');

      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus']))
        || isAdmin()
      );

      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Active sessions subcollection:
      // - Users can read, create, update, and delete their own device sessions
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Helper: Check if caller is an Admin or Security Researcher
    function isStaff() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.researcher == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'researcher'))
      );
    }

    // --- DATABASE 1: VERIFIED LINKS (PRODUCTION GROUND TRUTH) ---
    // Read: All authenticated agents (for real-time protection lookups)
    // Write: Strictly authorized security researchers & admins
    match /verified_links/{linkId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    // --- DATABASE 2: RAW SUBMISSIONS (ANTI-FLOOD INGESTION BUFFER) ---
    // Create/Update: Authenticated agents can report links or increment report counters
    // Read/Delete: Strictly researchers & admins for triage intake
    match /raw_submissions/{submissionId} {
      allow create, update: if request.auth != null;
      allow read, delete: if isStaff();
    }

    // --- DATABASE 3: TRIAGE BACKLOG (RESEARCHER WORKBENCH & SLA QUEUE) ---
    // Read/Write: Strictly researchers & admins to manage and audit backlog tickets
    match /triage_backlog/{ticketId} {
      allow read, write: if isStaff();
    }

    // Incident & bug reports collection:
    // - Authenticated users can create reports
    // - Users can read only their own submitted reports; admins can read all reports
    // - Status transitions ('read', 'resolved') restricted to admins
    // - Users can delete their own submitted reports upon account purge; admins can delete any report
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Default deny-all fallback for unspecified collections
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
